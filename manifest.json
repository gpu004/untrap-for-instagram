{
  "manifest_version": 3,
  "name": "Untrap for Instagram",
  "version": "0.1.0",
  "description": "Keep Instagram DMs, stories, and shared reels and posts. Hide the home feed and extra navigation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
